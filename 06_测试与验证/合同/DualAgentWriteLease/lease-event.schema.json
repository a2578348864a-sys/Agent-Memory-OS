{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-memory-os.invalid/agent-memory-os/write-lease-event.schema.json",
  "title": "Dual Agent Write Lease Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventType",
    "eventId",
    "projectId",
    "revision",
    "occurredAtUtc",
    "agent",
    "leaseId",
    "scope",
    "acquiredAtUtc",
    "expiresAtUtc",
    "previousEventSha256",
    "eventSha256",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventType": { "enum": ["initialized_idle", "acquired", "renewed", "released", "expired_recovered"] },
    "eventId": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "projectId": { "const": "agent-memory-os" },
    "revision": { "type": "integer", "minimum": 1 },
    "occurredAtUtc": { "type": "string", "format": "date-time" },
    "agent": { "type": ["string", "null"], "enum": ["codex", "claude", "dsh", "gemini", null] },
    "leaseId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "scope": { "type": ["string", "null"], "enum": ["automation_full_run", "nightly_health", "interactive_write", null] },
    "acquiredAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "expiresAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "previousEventSha256": { "type": ["string", "null"], "pattern": "^[0-9A-F]{64}$" },
    "eventSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
  }
}
