{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-memory-os.invalid/agent-memory-os/write-lease-state.schema.json",
  "title": "Dual Agent Write Lease State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "revision",
    "leaseStatus",
    "holderAgent",
    "leaseId",
    "scope",
    "acquiredAtUtc",
    "expiresAtUtc",
    "updatedAtUtc",
    "lastEventSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "const": "agent-memory-os" },
    "revision": { "type": "integer", "minimum": 1 },
    "leaseStatus": { "enum": ["idle", "active"] },
    "holderAgent": { "type": ["string", "null"], "enum": ["codex", "claude", "gemini", "cursor", "windsurf", null] },
    "leaseId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
    "scope": { "type": ["string", "null"], "enum": ["automation_full_run", "nightly_health", "interactive_write", null] },
    "acquiredAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "expiresAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "lastEventSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
  }
}
